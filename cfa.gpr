--  Core Flight Ada (CFA) — native Linux build
project Cfa is

   for Source_Dirs use ("src", "src/native");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("cfa_driver.adb", "cfa_native.adb");

   package Builder is
      for Default_Switches ("Ada") use ("-g");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnata",
         "-gnatwa",
         "-gnat12");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-g");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30", "--report=all");
   end Prove;

end Cfa;

